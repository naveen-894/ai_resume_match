# ---- Existing backend config (see README.md for details) ----
OPENAI_API_KEY=sk-...

# Postgres
HOST=localhost
PORT=5432
NAME=ai_resume_matcher
DB_USER=postgres
PASSWORD=your-db-password

# Auth
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LEGACY_PASSWORD_CIPHER_KEY=

# Credits charged per request
MATCH_RUN_COST=0.03
CHAT_MESSAGE_COST=0.002

# Optional S3 (file uploads)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1
S3_BUCKET=

# ---- Website AI Chatbot ----

# Feature flag — set to false to disable the chatbot endpoints without a redeploy
CHATBOT_ENABLED=true

# Shared secret the Next.js proxy sends on every chatbot request (defense-in-depth
# alongside CORS). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHATBOT_INTERNAL_API_KEY=

# LLM provider (reuses OPENAI_API_KEY above)
CHATBOT_LLM_PROVIDER=openai
CHATBOT_LLM_MODEL=gpt-4o-mini
CHATBOT_LLM_TEMPERATURE=0.3
CHATBOT_LLM_MAX_TOKENS=700
CHATBOT_LLM_TIMEOUT_SECONDS=20
CHATBOT_LLM_MAX_RETRIES=2
CHATBOT_GUARD_MODEL=gpt-4o-mini

# Embeddings (reuses OPENAI_API_KEY above)
CHATBOT_EMBEDDING_PROVIDER=openai
CHATBOT_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_EMBEDDING_DIMENSIONS=1536
CHATBOT_TOP_K=4
CHATBOT_MIN_SCORE=0.3

# Vector database — Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=modax-chatbot-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=website-kb

# Knowledge ingestion / chunking
CHATBOT_CHUNK_SIZE_CHARS=900
CHATBOT_CHUNK_OVERLAP_CHARS=150

# Conversation / session
CHATBOT_SESSION_TTL_HOURS=24
CHATBOT_MAX_HISTORY_MESSAGES=12
CHATBOT_MAX_MESSAGE_LENGTH=2000

# Rate limiting / abuse prevention
CHATBOT_RATE_LIMIT_MESSAGE=20/minute
CHATBOT_RATE_LIMIT_LEAD=5/hour
CHATBOT_RATE_LIMIT_SESSION=10/minute
CHATBOT_MAX_REQUEST_BYTES=20000

# Email notifications for captured leads (reuses the Resend account already
# used by the Next.js site's contact form — same API key, same destination)
RESEND_API_KEY=re_...
LEAD_NOTIFICATION_EMAIL=vnaveen894@gmail.com
CHATBOT_LEAD_FROM_EMAIL=Modax Chatbot <onboarding@resend.dev>

# Branding / copy (all configurable, no hardcoded knowledge in the prompt)
CHATBOT_COMPANY_NAME=Modax
CHATBOT_COMPANY_WEBSITE=https://modax.in
CHATBOT_CONTACT_URL=https://modax.in/contact
CHATBOT_GREETING_MESSAGE=Hi! Welcome to Modax. I'm your AI assistant. I can help you explore our services, understand our work, or discuss your project requirements. How can I help you today?
CHATBOT_SUGGESTED_PROMPTS=What services do you offer?|Tell me about your projects.|I need a custom software solution.|How can I start a project with your team?|How can I contact your company?
